<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fanknob.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fanknobd</string>
    </array>

    <!-- Start at boot and keep it running. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/fanknobd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/fanknobd.log</string>
</dict>
</plist>
