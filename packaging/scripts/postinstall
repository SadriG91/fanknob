#!/bin/sh
# postinstall — run as root by Installer after the payload is written.
#
# This is the whole reason fanknob ships as a .pkg rather than a .dmg: the
# installer is already root, so it can load the daemon itself and fan control
# works the moment the install finishes. No "now open a terminal and run this".

set -u

PLIST=/Library/LaunchDaemons/com.fanknob.daemon.plist
LABEL=com.fanknob.daemon
SOCKET=/var/run/fanknobd.sock
APP="${3:-/}"; APP="${APP%/}/Applications/Fanknob.app"

# Put the menu-bar icon on screen. Installing a menu-bar app and getting no
# menu bar item is a poor first minute, and the daemon being up doesn't help
# anyone who never opens a terminal.
#
# Everything here is best-effort: we run as root, and a failure to reach the
# logged-in session must never fail an install that has otherwise succeeded.
launch_app() {
    [ -d "$APP" ] || return 0

    # Who is actually at the screen — not $USER, which is root here.
    user=$(stat -f "%Su" /dev/console 2>/dev/null) || return 0
    [ -n "$user" ] && [ "$user" != "root" ] || return 0
    uid=$(id -u "$user" 2>/dev/null) || return 0

    # On an upgrade the old build is still running and would keep serving the
    # old code, so retire it first. SIGTERM, so it exits the way it expects to.
    launchctl asuser "$uid" pkill -x FanknobApp 2>/dev/null || true
    sleep 1

    launchctl asuser "$uid" sudo -u "$user" open -a "$APP" 2>/dev/null || true
}

# bootout first so an upgrade replaces the running daemon instead of colliding
# with it over the socket. The outgoing instance gets SIGTERM and hands the fans
# back to the firmware; the new one restores the persisted mode as it starts.
launchctl bootout "system/$LABEL" 2>/dev/null || true

# A socket left behind by the outgoing daemon would make the readiness check
# below pass without anything actually listening.
rm -f "$SOCKET"

if ! launchctl bootstrap system "$PLIST" 2>/dev/null; then
    sleep 1   # launchd occasionally needs a beat before it will reuse a label
    launchctl bootstrap system "$PLIST" || true
fi

# launchd accepting the job doesn't mean the daemon is alive — it can still exit
# on startup, for instance if another fanknobd already holds the singleton lock.
# The socket only appears once one has really bound it, so wait for that: better
# to fail here than to hand over an install that looks fine until someone tries
# to move a fan.
i=0
while [ "$i" -lt 20 ]; do
    if [ -S "$SOCKET" ]; then
        launch_app
        exit 0
    fi
    i=$((i + 1))
    sleep 0.25
done

echo "fanknob: the daemon did not come up — fan control will not work." >&2
echo "fanknob: check 'sudo launchctl print system/$LABEL' and /var/log/fanknobd.log" >&2
exit 1
